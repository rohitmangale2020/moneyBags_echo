{
  "info": {
    "_postman_id": "ce419bbb-9e5d-4b4f-8f0b-cb6645bcf890",
    "name": "Banking Platform - Gateway and Users API",
    "description": "Run Login first. It stores the JWT in the accessToken collection variable. The Users routes require the gateway to route /api/v1/users/** to Users Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "Admin123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
                  "var response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Login failure - wrong password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users through Gateway",
      "item": [
        {
          "name": "List users",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/users?page=0&size=20&sort=id,asc"
          },
          "response": []
        },
        {
          "name": "Create customer user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"email\": \"customer1@example.local\",\n  \"password\": \"Customer123!\",\n  \"role\": \"CUSTOMER\",\n  \"profile\": {\n    \"firstName\": \"Customer\",\n    \"middleName\": null,\n    \"lastName\": \"One\",\n    \"phoneNumber\": \"+919876543210\",\n    \"dateOfBirth\": \"2000-01-15\",\n    \"addressLine1\": \"123 Main Street\",\n    \"addressLine2\": null,\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560001\",\n    \"countryCode\": \"IN\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/users"
          },
          "response": []
        },
        {
          "name": "Get user by ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/users/{{userId}}"
          },
          "response": []
        },
        {
          "name": "Update user and profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1updated\",\n  \"email\": \"customer1updated@example.local\",\n  \"role\": \"CUSTOMER\",\n  \"profile\": {\n    \"firstName\": \"Customer\",\n    \"middleName\": null,\n    \"lastName\": \"Updated\",\n    \"phoneNumber\": \"+919876543210\",\n    \"dateOfBirth\": \"2000-01-15\",\n    \"addressLine1\": \"456 New Street\",\n    \"addressLine2\": null,\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"400001\",\n    \"countryCode\": \"IN\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/users/{{userId}}"
          },
          "response": []
        },
        {
          "name": "Change user password",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewCustomer123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/users/{{userId}}/password"
          },
          "response": []
        },
        {
          "name": "Change user status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gatewayUrl}}/api/v1/users/{{userId}}/status"
          },
          "response": []
        },
        {
          "name": "Deactivate user",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{gatewayUrl}}/api/v1/users/{{userId}}"
          },
          "response": []
        }
      ]
    }
  ]
}
