{
  "info": {
    "_postman_id": "27c6ef3d-52dc-4631-a12f-091cd17b2083",
    "name": "Users Controller API",
    "description": "Set userId to the id returned by Create User before running the requests that use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman-user-001\",\n  \"email\": \"postman-user-001@example.com\",\n  \"password\": \"correct-horse-battery-staple\",\n  \"profile\": {\n    \"firstName\": \"Postman\",\n    \"lastName\": \"User\",\n    \"phoneNumber\": \"+919876543210\",\n    \"dateOfBirth\": \"2000-01-01\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560001\",\n    \"countryCode\": \"IN\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/users"
      },
      "response": []
    },
    {
      "name": "Get All Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/users?page=0&size=20&sort=id,asc"
      },
      "response": []
    },
    {
      "name": "Get User by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      },
      "response": []
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman-user-001-updated\",\n  \"email\": \"postman-user-001-updated@example.com\",\n  \"profile\": {\n    \"firstName\": \"Updated\",\n    \"lastName\": \"User\",\n    \"phoneNumber\": \"+919876543210\",\n    \"dateOfBirth\": \"2000-01-01\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560001\",\n    \"countryCode\": \"IN\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      },
      "response": []
    },
    {
      "name": "Update Password",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"new-secure-password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}/password"
      },
      "response": []
    },
    {
      "name": "Update Status",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/users/{{userId}}/status"
      },
      "response": []
    },
    {
      "name": "Deactivate User",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/users/{{userId}}"
      },
      "response": []
    }
  ]
}
